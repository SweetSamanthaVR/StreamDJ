# StreamDJ configuration
# Copy this file to .env and fill in the values. Anything commented out is
# optional and shows its default.

# Where the stream goes. RTMP_URL must start with rtmp:// and both values
# come from whatever platform you are streaming to.
RTMP_URL=cdn_url_here
STREAM_KEY=stream_key_here

# Ports and hosts. The three processes talk to each other over these, so if
# you change a port here it applies everywhere at once.
# Hosts default to 127.0.0.1 (localhost only); set a host to 0.0.0.0 to make
# that service reachable from the network, but read the Security section of
# the README first.
TCP_PORT=5000
HTTP_PORT=4000
HTTP_HOST=127.0.0.1
PLAYER_API_PORT=3000
PLAYER_API_HOST=127.0.0.1

# Your music. The folder is scanned recursively at startup and watched
# afterwards, so files dropped in while running join the playlist. Supported
# formats: mp3, flac, ogg, opus, m4a, aac, wav, wma, aiff.
MUSIC_DIR=./media/music

# Output video. Width/height/fps set the encoded resolution and frame rate;
# for a static background with a text overlay, 15 fps is plenty and keeps CPU
# usage down. Bitrate is the x264 video bitrate; preset is an x264 speed
# preset (ultrafast through veryslow - slower means better compression for
# the same bitrate, at more CPU).
OVERLAY_WIDTH=1920
OVERLAY_HEIGHT=1080
OVERLAY_FPS=15
OVERLAY_BITRATE=1000k
OVERLAY_PRESET=veryfast

# Overlay text. Font size and line spacing here only seed the initial style;
# once the overlay editor in the web UI has saved a style, that takes over.
OVERLAY_FONTSIZE=48
OVERLAY_LINE_SPACING=12

# Path to a TrueType font on this machine. Update this for your OS, e.g.
# /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf on Debian/Ubuntu.
OVERLAY_FONT=C:/Windows/Fonts/arial.ttf

# The background image or video shown at startup. You can switch it at any
# time from the web UI; the choice is remembered in data/background.json.
OVERLAY_BACKGROUND=./media/stream-backgrounds/streamdj-default.png

# Directories the server is allowed to load backgrounds from, for when you
# set a background by path. Separate entries with ; on Windows and : on
# Linux/macOS. Defaults to the project root only.
# ALLOWED_BACKGROUND_DIRS=C:/backgrounds;D:/media

# Web UI. Poll interval is how often the browser refreshes its state, in
# milliseconds (minimum 1000).
WEBUI_PORT=8080
WEBUI_HOST=127.0.0.1
WEBUI_POLL_INTERVAL=2000

# Authentication (choose one or both)

# Option 1: password login (the sensible default for most people)
# Set a password to require login for the web UI, then restart the web UI.
# Username is optional; leave it out and the login page only asks for a
# password.
#
# To generate a secure password, run one of these commands:
#   Windows PowerShell: [Convert]::ToBase64String((1..16 | ForEach-Object { Get-Random -Max 256 }))
#   Linux/macOS:        openssl rand -base64 16
#   Node.js:            node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
#
# STREAMDJ_USERNAME=admin
# STREAMDJ_PASSWORD=your-password-here

# Option 2: API key (for programmatic access)
# When set, the server and player APIs require this key on every request
# except /health. Send it as Authorization: Bearer <key> or in an X-API-Key
# header.
#
# To generate a secure API key:
#   Linux/macOS:        openssl rand -hex 32
#   Node.js:            node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# STREAMDJ_API_KEY=your-secret-api-key-here

# Secret used to sign login session cookies. A random one is generated at
# startup if unset, which means sessions won't survive a web UI restart; set
# it if you want logins to persist across restarts.
# STREAMDJ_SESSION_SECRET=random-secret-string

# Logging. LOG_LEVEL is one of DEBUG, INFO, WARN, ERROR (default INFO).
# Set LOG_FORMAT=json for one JSON object per line instead of plain text.
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Monitoring intervals, all in milliseconds.
#   INGEST_LOG_INTERVAL_MS       how often incoming-audio throughput is logged
#   INGEST_IDLE_WARN_MS          warn if no audio arrives for this long
#   FFMPEG_HEARTBEAT_INTERVAL_MS how often encoder progress is logged
#   FFMPEG_STALL_WARN_MS         warn if the encoder makes no progress for this long
# INGEST_LOG_INTERVAL_MS=5000
# INGEST_IDLE_WARN_MS=8000
# FFMPEG_HEARTBEAT_INTERVAL_MS=7000
# FFMPEG_STALL_WARN_MS=20000

# Crash recovery. If FFmpeg dies unexpectedly it is restarted with
# exponential backoff. More than MAX_ATTEMPTS restarts inside WINDOW_MS and
# the server stops trying ("blocked") until it is unblocked manually via
# POST /ffmpeg/unblock, or automatically after five minutes. A run of
# STABLE_RUN_MS without a crash resets the counters. Set
# FFMPEG_AUTO_RESTART=false to disable restarts entirely.
# FFMPEG_AUTO_RESTART=true
# FFMPEG_RESTART_MAX_ATTEMPTS=5
# FFMPEG_RESTART_WINDOW_MS=60000
# FFMPEG_RESTART_BACKOFF_BASE_MS=500
# FFMPEG_RESTART_BACKOFF_MAX_MS=60000
# FFMPEG_STABLE_RUN_MS=120000
